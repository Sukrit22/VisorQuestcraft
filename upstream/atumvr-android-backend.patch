+    private void suggestPicoBindings(XrInstance instance, String profilePath,
+                                     List<PairRecord<XRAction, String>> bindings) {
+        int result = trySuggestBindings(instance, profilePath, bindings);
+        if (result == XR_SUCCESS) return;
+        if (result != XR_ERROR_PATH_UNSUPPORTED) {
+            vrProvider.checkXRError(result, "xrSuggestInteractionProfileBindings", profilePath);
+            return;
+        }
+        // Some Pico runtime versions do not expose every Touch capacitive input.
+        List<PairRecord<XRAction, String>> supported = new ArrayList<>();
+        for (var binding : bindings) {
+            if (trySuggestBindings(instance, profilePath, List.of(binding)) == XR_SUCCESS) {
+                supported.add(binding);
+            }
+        }
+        if (!supported.isEmpty()) {
+            vrProvider.checkXRError(trySuggestBindings(instance, profilePath, supported),
+                    "xrSuggestInteractionProfileBindings", profilePath);
+        } else {
+            vrProvider.getLogger().logWarn("Pico interaction profile unavailable: " + profilePath);
+        }
+    }
