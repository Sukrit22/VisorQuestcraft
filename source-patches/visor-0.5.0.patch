+        mixinConfig "visor.iris.mixins.json"
+        mixinConfig "visor.blur.mixins.json"
+        mixinConfig "visor.mixins.forge.json"
+    }
+}
+
+configurations {
+    common
+    shadowCommon // Don't use shadow from the shadow plugin because we don't want IDEA to index this.
+    bundle {
+        // bundle command, to copy jar contents with the shadow plugin
+        canBeResolved = true
+        canBeConsumed = false
+    }
+    compileClasspath.extendsFrom common
+    runtimeClasspath.extendsFrom common
+    developmentForge.extendsFrom common
+}
+
+version = version+"+mc"+libs.versions.minecraftVersion.get()+"-forge"
+
+dependencies {
+    compileOnly(project(path: ':visor-api', configuration: 'namedElements'))
