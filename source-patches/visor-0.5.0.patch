+    shadowCommon(libs.atumvr.config)
+
+
+
+    forgeRuntimeLibrary files(rootProject.file('libs/lwjgl-openxr-quest-3.3.3.jar'))
+
+    //vulkan bridge rail; no natives jar - lwjgl-vulkan loads the system loader
+    forgeRuntimeLibrary(libs.lwjgl.vulkan)
+
+    // shadow the natives
+    bundle files(rootProject.file('libs/lwjgl-openxr-quest-3.3.3.jar'))
+    bundle(libs.lwjgl.vulkan) { transitive = false }
+
+}
