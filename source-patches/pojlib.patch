+    public static void upgradeBundledForge(Activity activity, MinecraftInstances.Instance instance) throws IOException {
+        if (!instance.isForge()) return;
+        if (instance.forgeRoot == null || instance.classpath == null) throw new IOException("Incomplete Forge instance");
+        File oldRoot = new File(instance.forgeRoot).getCanonicalFile();
+        File newRoot = installBundledForge(activity).getCanonicalFile();
+        if (oldRoot.equals(newRoot)) return;
+        ForgeProfile profile = ForgeProfile.load(newRoot);
+        String migrated = ForgeProfile.migrateClasspath(instance.classpath, oldRoot, profile.classpath);
+        File registry = new File(Constants.USER_HOME, "instances.json");
+        File backup = new File(Constants.USER_HOME, "instances-before-forge-47.4.20.json");
+        if (registry.isFile() && !backup.exists()) Files.copy(registry.toPath(), backup.toPath());
+        instance.classpath = migrated;
+        instance.forgeRoot = newRoot.getAbsolutePath();
+        instance.mainClass = profile.mainClass;
+        Logger.getInstance().appendToLog("Updated instance to bundled Forge " + ForgeProfile.VERSION);
+    }
