+package pojlib.install;
+
+/** Persisted runtime IDs and bundled artifacts; missing IDs retain the 0.5 default. */
+public final class VisorRuntime {
+    private VisorRuntime() { }
+    public static final String FORGE_05 = "Visor-0.5.0-android-forge.1.jar";
+    public static final String FABRIC_05 = "Visor-0.5.0-android-fabric.1.jar";
+    public static final String FORGE_06 = "Visor-0.6.0-alpha.2-android.1+mc1.20.1-forge.jar";
+    public static void validate(String runtime, String loader) {
+        if (!"visor-0.5".equals(runtime) && !"visor-0.6".equals(runtime) && !"unmanaged".equals(runtime) && !"custom".equals(runtime))
+            throw new IllegalArgumentException("Unknown Visor runtime: " + runtime);
+        if ("visor-0.6".equals(runtime) && !"Forge".equals(loader))
+            throw new IllegalArgumentException("Visor 0.6 requires Forge");
+    }
+    public static String core(String runtime, String loader) {
+        validate(runtime, loader);
+        if ("unmanaged".equals(runtime)) return null;
+        return "visor-0.6".equals(runtime) ? FORGE_06 : ("Forge".equals(loader) ? FORGE_05 : FABRIC_05);
+    }
+    public static String[] managedFiles() {
+        return new String[] { FORGE_05, FABRIC_05, FORGE_06, "Visor.jar", "VisorEssentials.jar",
+            "Visor-0.5.0-pico-alpha.1.jar", "Visor-0.5.0-pico-alpha.2.jar", "Visor-0.5.0-pico-alpha.4.jar",
+            "Visor-Android-Bridge-0.1.0.jar", "Visor-Android-Bridge-0.1.1.jar" };
+    }
+}
