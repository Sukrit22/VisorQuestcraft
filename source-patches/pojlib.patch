+            gameDirFile.mkdirs();
+        }
+
+        VersionInfo modLoaderVersionInfo = null;
+        switch (modLoader) {
+            case "Fabric": {
+                if (!"1.20.1".equals(minecraftVersion)) throw new IllegalArgumentException("Fabric Visor requires Minecraft 1.20.1");
+                try {
+                    modLoaderVersionInfo = pojlib.install.FabricLoaderProfile.fetch(minecraftVersion, fabricLoaderVersion);
+                    instance.fabricLoaderVersion = fabricLoaderVersion;
+                    instance.fabricInstalledLoaderVersion = fabricLoaderVersion;
+                    instance.fabricLoaderLibraries = pojlib.install.FabricLoaderProfile.libraryNames(modLoaderVersionInfo);
+                    instance.fabricJvmArguments = pojlib.install.FabricLoaderProfile.jvmArguments(modLoaderVersionInfo);
+                } catch (IOException error) { throw new IllegalStateException("Could not download selected Fabric Loader profile: " + error.getMessage(), error); }
+                instance.defaultMods = false;
+                break;
+            }
+            case "Quilt": {
+                QuiltMeta.QuiltVersion quiltVersion = QuiltMeta.getLatestVersion();
+                assert quiltVersion != null;
+                modLoaderVersionInfo = QuiltMeta.getVersionInfo(quiltVersion, minecraftVersion);
+                break;
