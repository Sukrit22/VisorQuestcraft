index 0000000000000000000000000000000000000000..3ec40828212ba7296b358e1fcc397ddf34706be9
--- /dev/null
+++ b/src/main/java/pojlib/install/ForgeMods.java
@@ -0,0 +1,68 @@
+package pojlib.install;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.jar.JarEntry;
+import java.util.jar.JarFile;
+import java.util.regex.Pattern;
+
+/** Preflight only: metadata cannot prove Android native/VR compatibility. */
+public final class ForgeMods {
+    private ForgeMods() { }
+
+    public static boolean isVivecraft(String name) {
+        return name != null && name.toLowerCase(Locale.ROOT).contains("vivecraft");
+    }
+
+    public static void validate(File mods) throws IOException {
+        File[] files = mods.listFiles((dir, name) -> name.toLowerCase(Locale.ROOT).endsWith(".jar"));
+        int visorCount = 0;
+        if (files != null) for (File file : files) {
+            if (isVivecraft(file.getName())) throw new IOException("Remove Vivecraft from the Forge instance: " + file.getName());
+            try (JarFile jar = new JarFile(file)) {
+                JarEntry metadata = jar.getJarEntry("META-INF/mods.toml");
+                if (metadata == null) {
+                    if (jar.getJarEntry("fabric.mod.json") != null) {
+                        throw new IOException("Fabric-only mod in Forge instance: " + file.getName());
+                    }
+                    continue;
+                }
+                String toml;
+                try (InputStream in = jar.getInputStream(metadata)) {
+                    ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+                    byte[] bytes = new byte[4096];
+                    int count;
+                    while ((count = in.read(bytes)) != -1) buffer.write(bytes, 0, count);
+                    toml = new String(buffer.toByteArray(), StandardCharsets.UTF_8);
+                }
+                if (declaresMod(toml, "vivecraft")) {
+                    throw new IOException("Vivecraft is not supported in this Visor instance: " + file.getName());
+                }
+                if (declaresMod(toml, "visor")) visorCount++;
+            }
+        }
+        if (visorCount != 1) throw new IOException("Expected exactly one Quest/Pico-compatible Forge Visor jar; found " + visorCount);
+    }
+
+    private static boolean declaresMod(String toml, String id) {
+        boolean inMods = false;
+        for (String line : toml.split("\\r?\\n")) {
+            String trimmed = line.trim();
+            if (trimmed.startsWith("[")) {
+                inMods = trimmed.matches("\\[\\[\\s*mods\\s*\\]\\]\\s*(?:#.*)?");
+            } else if (inMods && modId(id).matcher(line).matches()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static Pattern modId(String id) {
+        return Pattern.compile("(?m)^\\s*modId\\s*=\\s*[\"']" + id + "[\"']\\s*(?:#.*)?$");
+    }
+}
+
diff --git a/src/main/java/pojlib/install/ForgeProfile.java b/src/main/java/pojlib/install/ForgeProfile.java
new file mode 100644
index 0000000000000000000000000000000000000000..46b34c851da7329dde5c01d4eb3d3f8e3eed8366
--- /dev/null
+++ b/src/main/java/pojlib/install/ForgeProfile.java
@@ -0,0 +1,140 @@
+package pojlib.install;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.File;
+import java.io.IOException;
+import java.io.Reader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.HashMap;
+
+/** Reads a client installation prepared by the official Forge installer on a PC.
+ * Installer processors must have run before this profile can be used on Android.
+ */
+public final class ForgeProfile {
+    /** Preserve class loading order while avoiding duplicate SecureJar union paths. */
+    public static String uniqueClasspath(String value) {
+        java.util.LinkedHashSet<String> paths = new java.util.LinkedHashSet<>();
+        for (String path : value.split(java.util.regex.Pattern.quote(File.pathSeparator), -1)) {
+            if (!path.isEmpty()) paths.add(path);
+        }
+        return String.join(File.pathSeparator, paths);
+    }
+    public static final String VERSION = "1.20.1-47.4.20";
+    public static String migrateClasspath(String current, File oldRoot, String replacement) throws IOException {
+        String oldLibraries = new File(oldRoot, "libraries").getCanonicalPath() + File.separator;
+        List<String> retained = new ArrayList<>();
+        for (String path : current.split(java.util.regex.Pattern.quote(File.pathSeparator))) {
+            if (!path.isEmpty() && !new File(path).getCanonicalPath().startsWith(oldLibraries)) retained.add(path);
+        }
+        retained.add(replacement);
+        return uniqueClasspath(String.join(File.pathSeparator, retained));
+    }
+    public final String id;
+    public final String mainClass;
+    public final String classpath;
+    private final JsonObject arguments;
+    private final File libraries;
+
+    private ForgeProfile(JsonObject profile, File root) throws IOException {
+        if (!"1.20.1".equals(string(profile, "inheritsFrom"))) {
+            throw new IOException("Only Minecraft 1.20.1 Forge profiles are supported");
+        }
+        id = string(profile, "id");
+        if (!"1.20.1-forge-47.4.20".equals(id)) throw new IOException("Expected Forge 47.4.20 profile");
+        mainClass = string(profile, "mainClass");
+        if (!"cpw.mods.bootstraplauncher.BootstrapLauncher".equals(mainClass)) {
+            throw new IOException("Unexpected Forge main class: " + mainClass);
+        }
+        libraries = new File(root, "libraries").getCanonicalFile();
+        arguments = profile.getAsJsonObject("arguments");
+        if (arguments == null) throw new IOException("Forge profile has no arguments");
+        List<String> paths = new ArrayList<>();
+        JsonArray entries = profile.getAsJsonArray("libraries");
+        if (entries == null) throw new IOException("Forge profile has no libraries");
+        for (JsonElement entry : entries) {
+            JsonObject library = entry.getAsJsonObject();
+            // A Forge overlay should not install desktop LWJGL over Pojlib's Android LWJGL.
+            if (string(library, "name").startsWith("org.lwjgl:")) continue;
+            if (library.has("rules")) throw new IOException("Conditional Forge library is not supported");
+            JsonObject downloads = library.getAsJsonObject("downloads");
+            JsonObject artifact = downloads == null ? null : downloads.getAsJsonObject("artifact");
+            if (artifact == null) throw new IOException("Forge library has no artifact");
+            String relative = string(artifact, "path");
+            if (relative.contains("\\") || relative.contains(":") || relative.startsWith("/")) {
+                throw new IOException("Invalid Forge library path: " + relative);
+            }
+            File file = new File(libraries, relative).getCanonicalFile();
+            if (!file.toPath().startsWith(libraries.toPath()) || !file.isFile() || file.length() == 0) {
+                throw new IOException("Missing/invalid Forge library: " + relative
+                        + ". Run the PC preparation script and copy the complete installation.");
+            }
+            paths.add(file.getAbsolutePath());
+        }
+        if (paths.isEmpty()) throw new IOException("Forge profile has no usable libraries");
+        File patched = new File(libraries, "net/minecraftforge/forge/" + VERSION + "/forge-" + VERSION + "-client.jar");
+        if (!patched.isFile() || patched.length() == 0) {
+            throw new IOException("Forge client patch processor output is missing: " + patched);
+        }
+        classpath = String.join(File.pathSeparator, paths);
+    }
+
+    public static ForgeProfile load(File root) throws IOException {
+        File profile = new File(root, "profile.json");
+        if (!profile.isFile()) throw new IOException("Prepared Forge installation is missing: " + profile);
+        try (Reader reader = Files.newBufferedReader(profile.toPath(), StandardCharsets.UTF_8)) {
+            return new ForgeProfile(JsonParser.parseReader(reader).getAsJsonObject(), root);
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid Forge profile: " + profile, e);
+        }
+    }
+
+    public List<String> jvmArguments(String fullClasspath) throws IOException {
+        return resolve("jvm", fullClasspath);
+    }
+
+    public List<String> gameArguments(String fullClasspath) throws IOException {
+        return resolve("game", fullClasspath);
+    }
+
+    private List<String> resolve(String type, String fullClasspath) throws IOException {
+        Map<String, String> values = new HashMap<>();
+        values.put("library_directory", libraries.getAbsolutePath());
+        values.put("classpath_separator", File.pathSeparator);
+        values.put("version_name", id);
+        values.put("classpath", fullClasspath);
+        List<String> result = new ArrayList<>();
+        JsonArray args = arguments.getAsJsonArray(type);
+        if (args == null) throw new IOException("Missing Forge " + type + " arguments");
+        for (JsonElement element : args) {
+            if (!element.isJsonPrimitive() || !element.getAsJsonPrimitive().isString()) {
+                throw new IOException("Conditional Forge arguments are not supported");
+            }
+            String value = element.getAsString();
+            for (Map.Entry<String, String> replacement : values.entrySet()) {
+                value = value.replace("${" + replacement.getKey() + "}", replacement.getValue());
+            }
+            if (value.contains("${")) throw new IOException("Unresolved Forge argument: " + value);
+            // Pojlib names the vanilla download client.jar, unlike the official launcher.
+            // Forge supplies Minecraft through its transforming loader instead.
+            if (value.startsWith("-DignoreList=")) value += ",client.jar";
+            result.add(value);
+        }
+        return result;
+    }
+
+    private static String string(JsonObject object, String key) throws IOException {
+        if (!object.has(key) || !object.get(key).isJsonPrimitive()
+                || !object.getAsJsonPrimitive(key).isString()) {
+            throw new IOException("Missing string field: " + key);
+        }
+        return object.get(key).getAsString();
+    }
+}
+
