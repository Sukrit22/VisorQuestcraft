+        }
+        // Manual instances opt out of runtime installation and retirement entirely.
+        if ("unmanaged".equals(instance.getVisorRuntime())) return;
+        boolean custom = "custom".equals(instance.getVisorRuntime());
+        File customJar = custom ? CustomVisor.prepare(instance) : null;
+        final String name;
+        try { name = custom ? "Visor-custom-" + instance.visorSha256 + ".jar" : VisorRuntime.core(instance.getVisorRuntime(), instance.getModLoader()); }
+        catch (IllegalArgumentException e) { throw new IOException(e.getMessage(), e); }
+        if (!"1.20.1".equals(instance.versionName)
+                || (!instance.isForge() && !"Fabric".equals(instance.getModLoader())))
+            throw new IOException("Supported instances: Forge or Fabric, Minecraft 1.20.1");
+        if (!instance.isForge()) applyQuestDefaults(instance);
+        String asset = "mods/" + (instance.isForge() ? "forge/" : "fabric/") + name;
+        File target = new File(instance.gameDir, "mods/" + name);
+        FileUtils.forceMkdir(target.getParentFile());
+        // Stage the selected core and bridge before touching the active runtime.
+        File staged = new File(target.getPath() + ".installing");
+        boolean replace = custom ? (!target.isFile() || !CustomVisor.digest(target).equals(instance.visorSha256)) : !FileUtil.matchingAssetFile(activity, asset, target);
+        if (replace) {
+            if (custom) Files.copy(customJar.toPath(), staged.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            else FileUtil.copyAssetToFile(activity, asset, staged);
+        }
+        boolean bridge = custom ? CustomVisor.needsBridge(customJar, instance.getModLoader()) : "visor-0.5".equals(instance.getVisorRuntime());
+        String bridgeName = "Visor-Android-Bridge-0.1.1.jar";
+        File bridgeTarget = new File(target.getParentFile(), bridgeName);
+        File bridgeStaged = new File(bridgeTarget.getPath() + ".installing");
+        boolean replaceBridge = bridge && !FileUtil.matchingAssetFile(activity, "mods/android/" + bridgeName, bridgeTarget);
+        if (replaceBridge) FileUtil.copyAssetToFile(activity, "mods/android/" + bridgeName, bridgeStaged);
+        for (String prior : VisorRuntime.managedFiles()) {
+            if (prior.equals(name) && !replace) continue;
+            if (bridge && prior.equals(bridgeName) && !replaceBridge) continue;
+            backupLegacyVisor(instance, prior);
+        }
+        File[] priorCustom = target.getParentFile().listFiles((dir, fileName) -> fileName.matches("Visor-custom-[0-9a-f]{64}\\.jar"));
+        if (priorCustom != null) for (File prior : priorCustom) {
+            if (!prior.getName().equals(name) || replace) backupLegacyVisor(instance, prior.getName());
+        }
+        if (replace) Files.move(staged.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
+        if (replaceBridge) Files.move(bridgeStaged.toPath(), bridgeTarget.toPath(), StandardCopyOption.REPLACE_EXISTING);
+        if (instance.isForge()) ForgeMods.validate(target.getParentFile());
+        else FabricMods.validate(target.getParentFile());
+    }
+
+    private static void backupLegacyVisor(MinecraftInstances.Instance instance, String name) throws IOException {
+        File old = new File(instance.gameDir, "mods/" + name);
+        if (!old.isFile()) return;
+        File backup = new File(instance.gameDir, "visor-backups/" + java.util.UUID.randomUUID() + "-" + name);
+        FileUtils.forceMkdir(backup.getParentFile());
+        Files.move(old.toPath(), backup.toPath());
+    }
+
+    private static void applyQuestDefaults(MinecraftInstances.Instance instance) throws IOException {
+        File marker = new File(instance.gameDir, ".qcx-render-distance-4");
+        if (marker.isFile()) {
+            return;
+        }
+
+        File options = new File(instance.gameDir, "options.txt");
+        if (options.isFile()) {
+            List<String> lines = Files.readAllLines(options.toPath(), StandardCharsets.UTF_8);
+            for (int i = 0; i < lines.size(); i++) {
+                String line = lines.get(i);
+                if (line.startsWith("renderDistance:")) {
+                    lines.set(i, "renderDistance:4");
+                } else if (line.startsWith("simulationDistance:")) {
+                    lines.set(i, "simulationDistance:4");
+                }
+            }
+            Files.write(options.toPath(), lines, StandardCharsets.UTF_8);
+        }
+        marker.createNewFile();
+    }
+
+    private static void installImmediatelyFast(File mods) throws IOException {
+        File target = new File(mods, "ImmediatelyFast.jar");
+        if (target.isFile() && DownloadUtils.compareSHA1(target, IMMEDIATELY_FAST_SHA1)) {
+            return;
+        }
+
+        File update = new File(mods, "ImmediatelyFast.jar.update");
+        FileUtils.deleteQuietly(update);
+        try {
+            DownloadUtils.downloadFile(IMMEDIATELY_FAST_URL, update, 348818);
+            if (!DownloadUtils.compareSHA1(update, IMMEDIATELY_FAST_SHA1)) {
+                throw new IOException("ImmediatelyFast download hash mismatch");
+            }
+            Files.move(update.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
+        } finally {
+            FileUtils.deleteQuietly(update);
+        }
+    }
+
+    public static class AsyncDownload implements Runnable {
+        private final Map.Entry<String, JsonElement> entry;
+        private final String gameDir;
+        private final String fileName;
+
+        public AsyncDownload(Map.Entry<String, JsonElement> entry, String gameDir) {
+            this.entry = entry;
+            this.gameDir = gameDir;
+            this.fileName = entry.getKey();
+        }
+
+        @Override
+        public void run() {
+            VersionInfo.Asset asset = new Gson().fromJson(entry.getValue(), VersionInfo.Asset.class);
+            String path = asset.hash.substring(0, 2) + "/" + asset.hash;
+            File assetFile = new File(gameDir + "/assets/objects/", path);
+
+            for (int i = 0; i < 5; i++) {
+                if (i == 4) throw new RuntimeException(String.format("Asset download of %s failed after 5 retries", fileName));
+
+                if (!assetFile.exists()) {
+                    Logger.getInstance().appendToLog("Downloading: " + fileName);
+                    try {
+                        DownloadUtils.downloadFile(Constants.MOJANG_RESOURCES_URL + "/" + path, assetFile, 0);
+                    } catch (IOException e) {
+                        throw new RuntimeException(e);
+                    }
+                }
+
+                if (DownloadUtils.compareSHA1(assetFile, asset.hash)) {
+                    break;
+                } else {
+                    assetFile.delete();
+                }
+            }
+        }
+    }
+
+
+    //Used for mod libraries, vanilla is handled a different (tbh better) way
+    private static String parseLibraryNameToPath(String libraryName) {
+        String[] parts = libraryName.split(":");
+        String location = parts[0].replace(".", "/");
+        String name = parts[1];
+        String version = parts[2];
+
+        return String.format("%s/%s/%s/%s", location, name, version, name + "-" + version + ".jar");
+    }
+}
