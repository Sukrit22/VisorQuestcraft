+    private static void copyAssetDirectory(Activity activity, String assetPath, File target) throws IOException {
+        String[] children = activity.getAssets().list(assetPath);
+        if (children != null && children.length > 0) {
+            FileUtils.forceMkdir(target);
+            for (String child : children) {
+                copyAssetDirectory(activity, assetPath + "/" + child, new File(target, child));
+            }
+        } else {
+            FileUtils.forceMkdir(target.getParentFile());
+            File temporary = new File(target.getPath() + ".installing");
+            FileUtil.copyAssetToFile(activity, assetPath, temporary);
+            Files.move(temporary.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
