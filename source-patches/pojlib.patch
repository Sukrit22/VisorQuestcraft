+package pojlib.install;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.jar.JarEntry;
+import java.util.jar.JarFile;
+
+/** Metadata preflight; this cannot prove that arbitrary mods work on Android. */
+public final class FabricMods {
+    private FabricMods() { }
+
+    public static void validate(File mods) throws IOException {
+        File[] files = mods.listFiles((dir, name) -> name.toLowerCase(Locale.ROOT).endsWith(".jar"));
+        int visorCount = 0;
+        if (files != null) for (File file : files) {
+            try (JarFile jar = new JarFile(file)) {
+                JarEntry metadata = jar.getJarEntry("fabric.mod.json");
+                if (metadata == null) {
+                    if (jar.getJarEntry("META-INF/mods.toml") != null)
+                        throw new IOException("Forge-only mod in Fabric instance: " + file.getName());
+                    continue;
+                }
+                try (InputStreamReader reader = new InputStreamReader(jar.getInputStream(metadata), StandardCharsets.UTF_8)) {
+                    JsonObject json = new JsonParser().parse(reader).getAsJsonObject();
+                    String id = json.get("id").getAsString();
+                    if ("vivecraft".equals(id)) throw new IOException("Remove Vivecraft from this Visor instance: " + file.getName());
+                    if ("visor".equals(id)) visorCount++;
+                } catch (RuntimeException error) {
+                    throw new IOException("Invalid Fabric metadata: " + file.getName(), error);
+                }
+            }
+        }
+        if (visorCount != 1) throw new IOException("Expected exactly one Android-compatible Fabric Visor jar; found " + visorCount);
+    }
+}
