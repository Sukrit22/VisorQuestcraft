+        conn.connect();
+        if(conn.getResponseCode() < 200 || conn.getResponseCode() >= 300) {
+            throw getResponseThrowable(conn);
+        }
+        // We don't need any data from this request, it just needs to happen in order for
+        // the MS servers to work properly. The data from this is practically useless
+        // as it does not indicate whether the user owns the game through Game Pass.
+    }
+
+    // Returns false for failure //
+    public boolean checkMcProfile(String mcAccessToken) throws IOException, MSAException, JSONException {
+        URL url = new URL(Constants.MC_PROFILE_URL);
+
+        HttpURLConnection conn = (HttpURLConnection)url.openConnection();
+        conn.setRequestProperty("Authorization", "Bearer " + mcAccessToken);
+        conn.setConnectTimeout(15000);
+        conn.setReadTimeout(30000);
+        conn.setUseCaches(false);
+        conn.connect();
+
+        if(conn.getResponseCode() >= 200 && conn.getResponseCode() < 300) {
+            String s = FileUtil.read(conn.getInputStream());
+            conn.disconnect();
+            Logger.getInstance().appendToLog("MicrosoftLogin | profile:" + s);
+            JSONObject jsonObject = new JSONObject(s);
+            String name = (String) jsonObject.get("name");
+            String uuid = (String) jsonObject.get("id");
+            String uuidDashes = uuid.replaceFirst(
+                    "(\\p{XDigit}{8})(\\p{XDigit}{4})(\\p{XDigit}{4})(\\p{XDigit}{4})(\\p{XDigit}+)", "$1-$2-$3-$4-$5"
+            );
+            doesOwnGame = true;
+            Logger.getInstance().appendToLog("MicrosoftLogin | UserName = " + name);
+            Logger.getInstance().appendToLog("MicrosoftLogin | Uuid Minecraft = " + uuidDashes);
+            mcName = name;
+            mcUuid = uuidDashes;
+            return true;
+        } else if (conn.getResponseCode() == 404) {
+            conn.disconnect();
+            Logger.getInstance().appendToLog("MicrosoftLogin | It seems that this Microsoft Account does not own the game, setting game to demo mode.");
+            doesOwnGame = false;
+            return false;
+        } else {
+            int status = conn.getResponseCode();
+            conn.disconnect();
+            throw new IOException("Minecraft profile request failed (HTTP " + status + ")");
+        }
+    }
+
+    /** Set common properties for the connection. Given that all requests are POST, interactivity is always enabled */
+    private static void setCommonProperties(HttpURLConnection conn, String formData) {
+        conn.setRequestProperty("Content-Type", "application/json");
+        conn.setRequestProperty("Accept", "application/json");
+        conn.setRequestProperty("charset", "utf-8");
+        try {
+            conn.setRequestProperty("Content-Length", Integer.toString(formData.getBytes(StandardCharsets.UTF_8).length));
+            conn.setRequestMethod("POST");
+        }catch (ProtocolException e) {
+            Logger.getInstance().appendToLog("MicrosoftAuth | " + e);
+        }
+        conn.setConnectTimeout(15000);
+        conn.setReadTimeout(30000);
+        conn.setUseCaches(false);
+        conn.setDoInput(true);
+        conn.setDoOutput(true);
+    }
+
+    /**
+     * @param data A series a strings: key1, value1, key2, value2...
+     * @return the data converted as a form string for a POST request
+     */
+    private static String convertToFormData(String... data) throws UnsupportedEncodingException {
+        StringBuilder builder = new StringBuilder();
+        for(int i=0; i<data.length; i+=2){
+            if (builder.length() > 0) builder.append("&");
+            builder.append(URLEncoder.encode(data[i], "UTF-8"))
+                    .append("=")
+                    .append(URLEncoder.encode(data[i+1], "UTF-8"));
+        }
+        return builder.toString();
+    }
+
+    private static MSAException getResponseThrowable(HttpURLConnection conn) throws IOException, MSAException {
+        Logger.getInstance().appendToLog("MicrosoftLogin | Error code: " + conn.getResponseCode() + ": " + conn.getResponseMessage());
+        if(conn.getResponseCode() == 429) {
+            throw new MSAException("Too many requests, please try again later.");
+        }
+        throw new MSAException(conn.getResponseMessage());
+    }
+}
diff --git a/src/main/java/pojlib/install/CustomVisor.java b/src/main/java/pojlib/install/CustomVisor.java
new file mode 100644
index 0000000000000000000000000000000000000000..6a8235d85aa536f6498af6621cded6bc6e555c50
--- /dev/null
+++ b/src/main/java/pojlib/install/CustomVisor.java
@@ -0,0 +1,177 @@
+package pojlib.install;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.security.*;
+import java.util.Locale;
+import java.util.jar.*;
+import pojlib.util.json.MinecraftInstances;
+
+/** Bounded HTTPS download, content pinning and Android architecture preflight. */
+public final class CustomVisor {
+    private CustomVisor() { }
+    public static void validateSelection(String url, String sha) {
+        try {
+            URI uri = new URI(url == null ? "" : url);
+            if (!"https".equalsIgnoreCase(uri.getScheme()) || uri.getHost() == null || uri.getUserInfo() != null)
+                throw new IllegalArgumentException("Visor URL must be a direct HTTPS JAR link");
+        } catch (URISyntaxException e) { throw new IllegalArgumentException("Invalid Visor HTTPS URL", e); }
+        if (sha != null && !sha.trim().isEmpty() && !sha.trim().matches("(?i)[0-9a-f]{64}"))
+            throw new IllegalArgumentException("SHA-256 must contain exactly 64 hexadecimal characters");
+    }
+    public static File prepare(MinecraftInstances.Instance instance) throws IOException {
+        try { validateSelection(instance.visorUrl, instance.visorSha256); }
+        catch (IllegalArgumentException e) { throw new IOException(e.getMessage(), e); }
+        File cache = new File(instance.gameDir, "visor-downloads");
+        Files.createDirectories(cache.toPath());
+        if (instance.visorSha256 != null) {
+            File pinned = new File(cache, instance.visorSha256.toLowerCase(Locale.ROOT) + ".jar");
+            if (pinned.isFile() && digest(pinned).equalsIgnoreCase(instance.visorSha256)) {
+                needsBridge(pinned, instance.getModLoader());
+                return pinned;
+            }
+        }
+        File temporary = File.createTempFile("visor-", ".download", cache);
+        try {
+            download(instance.visorUrl, temporary);
+            String hash = verifyDownloaded(temporary, instance.visorSha256, instance.getModLoader());
+            File pinned = new File(cache, hash + ".jar");
+            Files.move(temporary.toPath(), pinned.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            instance.visorSha256 = hash;
+            return pinned;
+        } finally { Files.deleteIfExists(temporary.toPath()); }
+    }
+    public static String verifyDownloaded(File file, String expectedSha256, String loader) throws IOException {
+        String hash = digest(file);
+        if (expectedSha256 != null && !expectedSha256.equalsIgnoreCase(hash))
+            throw new IOException("Custom Visor SHA-256 mismatch; previous runtime retained");
+        needsBridge(file, loader);
+        return hash;
+    }
+    private static void download(String address, File target) throws IOException {
+        long deadline = System.nanoTime() + 120000000000L;
+        URL url = new URL(address);
+        for (int redirects = 0; redirects < 6; redirects++) {
+            if (!"https".equalsIgnoreCase(url.getProtocol()) || url.getUserInfo() != null)
+                throw new IOException("Custom Visor redirects must stay on HTTPS");
+            if (System.nanoTime() > deadline) throw new IOException("Visor download timed out");
+            HttpURLConnection connection = (HttpURLConnection) url.openConnection();
+            connection.setConnectTimeout(15000); connection.setReadTimeout(15000);
+            connection.setInstanceFollowRedirects(false);
+            try {
+                int status = connection.getResponseCode();
+                if (status >= 300 && status < 400) {
+                    String location = connection.getHeaderField("Location");
+                    if (location == null) throw new IOException("Visor download redirect has no location");
+                    url = new URL(url, location); continue;
+                }
+                if (status != 200) throw new IOException("Visor download returned HTTP " + status);
+                if (connection.getContentLengthLong() > 67108864L) throw new IOException("Visor JAR exceeds 64 MiB");
+                try (InputStream input = connection.getInputStream(); OutputStream output = new FileOutputStream(target)) {
+                    byte[] bytes = new byte[16384]; long total = 0; int count;
+                    while ((count = input.read(bytes)) != -1) {
+                        total += count;
+                        if (total > 67108864L) throw new IOException("Visor JAR exceeds 64 MiB");
+                        if (System.nanoTime() > deadline) throw new IOException("Visor download timed out");
+                        output.write(bytes, 0, count);
+                    }
+                }
+                return;
+            } finally { connection.disconnect(); }
+        }
+        throw new IOException("Too many Visor download redirects");
+    }
+    public static String digest(File file) throws IOException {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            try (InputStream input = new FileInputStream(file)) {
+                byte[] bytes = new byte[16384]; int count;
+                while ((count = input.read(bytes)) != -1) digest.update(bytes, 0, count);
+            }
+            StringBuilder text = new StringBuilder();
+            for (byte value : digest.digest()) text.append(String.format(Locale.ROOT, "%02x", value & 255));
+            return text.toString();
+        } catch (NoSuchAlgorithmException e) { throw new IOException(e); }
+    }
+    private static byte[] entry(JarFile jar, String name) throws IOException {
+        JarEntry entry = jar.getJarEntry(name);
+        if (entry == null) throw new IOException("Custom Visor lacks Android runtime entry: " + name);
+        try (InputStream input = jar.getInputStream(entry); ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+            byte[] bytes = new byte[8192]; int count;
+            while ((count = input.read(bytes)) != -1) {
+                if (output.size() + count > 2097152) throw new IOException("Oversized Visor metadata/class entry");
+                output.write(bytes, 0, count);
+            }
+            return output.toByteArray();
+        }
+    }
+    public static boolean needsBridge(File file, String loader) throws IOException {
+        try (JarFile jar = new JarFile(file)) {
+            java.util.Enumeration<JarEntry> entries = jar.entries();
+            while (entries.hasMoreElements()) {
+                JarEntry item = entries.nextElement();
+                String name = item.getName().toLowerCase(Locale.ROOT);
+                if (name.endsWith(".dll") || name.endsWith(".dylib") || (name.contains("linux/") && name.endsWith(".so")))
+                    throw new IOException("Custom Visor contains desktop native libraries");
+                if (name.startsWith("org/vmstudio/visor/") && name.endsWith(".class")) {
+                    try (DataInputStream input = new DataInputStream(jar.getInputStream(item))) {
+                        if (input.readInt() != 0xCAFEBABE) throw new IOException("Invalid Visor class file");
+                        input.readUnsignedShort();
+                        if (input.readUnsignedShort() > 61) throw new IOException("Custom Visor requires newer than Java 17");
+                    }
+                }
+            }
+            String version;
+            if ("Forge".equals(loader)) {
+                String metadata = new String(entry(jar, "META-INF/mods.toml"), StandardCharsets.UTF_8);
+                java.util.regex.Matcher mod = java.util.regex.Pattern.compile("(?s)\\[\\[mods\\]\\](.*?)(?=\\n\\s*\\[|$)").matcher(metadata);
+                String visor = null;
+                while (mod.find()) if (mod.group(1).matches("(?s).*modId\\s*=\\s*[\"']visor[\"'].*")) visor = mod.group(1);
+                if (visor == null) throw new IOException("Downloaded JAR is not a Forge Visor mod");
+                java.util.regex.Matcher value = java.util.regex.Pattern.compile("version\\s*=\\s*[\"']([^\"']+)").matcher(visor);
+                if (!value.find()) throw new IOException("Visor version metadata is missing");
+                version = value.group(1);
+                java.util.regex.Matcher dependencies = java.util.regex.Pattern.compile("(?s)\\[\\[dependencies\\.visor\\]\\](.*?)(?=\\n\\s*\\[|$)").matcher(metadata);
+                boolean minecraft = false;
+                while (dependencies.find()) {
+                    String dependency = dependencies.group(1);
+                    if (!java.util.regex.Pattern.compile("(?m)^\\s*modId\\s*=\\s*[\"']minecraft[\"']\\s*$").matcher(dependency).find()) continue;
+                    java.util.regex.Matcher range = java.util.regex.Pattern.compile("(?m)^\\s*versionRange\\s*=\\s*[\"']([^\"']+)[\"']\\s*$").matcher(dependency);
+                    if (range.find() && ("[1.20,1.20.1]".equals(range.group(1)) || "[1.20.1]".equals(range.group(1)))) minecraft = true;
+                }
+                if (!minecraft) throw new IOException("Custom Visor must target Minecraft 1.20.1");
+            } else if ("Fabric".equals(loader)) {
+                JsonObject metadata = JsonParser.parseString(new String(entry(jar, "fabric.mod.json"), StandardCharsets.UTF_8)).getAsJsonObject();
+                if (!"visor".equals(metadata.get("id").getAsString())) throw new IOException("Downloaded JAR is not a Fabric Visor mod");
+                version = metadata.get("version").getAsString();
+                com.google.gson.JsonElement minecraft = metadata.getAsJsonObject("depends").get("minecraft");
+                boolean compatible = false;
+                if (minecraft.isJsonPrimitive()) compatible = "1.20.1".equals(minecraft.getAsString());
+                else if (minecraft.isJsonArray()) for (com.google.gson.JsonElement value : minecraft.getAsJsonArray()) {
+                    if (value.isJsonPrimitive() && "1.20.1".equals(value.getAsString())) compatible = true;
+                }
+                if (!compatible) throw new IOException("Custom Visor must explicitly target Minecraft 1.20.1");
+            } else throw new IOException("Custom Visor supports Forge and Fabric only");
+            entry(jar, "me/phoenixra/atumvr/core/session/platform/AndroidXRBridge.class");
+            entry(jar, "me/phoenixra/atumvr/core/session/platform/XRPlatform$Android.class");
+            entry(jar, "org/lwjgl/openxr/XrGraphicsBindingOpenGLESAndroidKHR.class");
+            String prefix = "org/vmstudio/visor/core/client/provider/openxr/";
+            if ("0.6.0-alpha.2".equals(version) && "Forge".equals(loader)) {
+                entry(jar, prefix + "QuestAndroidXRBridge.class"); entry(jar, prefix + "QuestVLoader.class");
+                return false;
+            }
+            if ("0.5.0".equals(version) && jar.getJarEntry(prefix + "QuestVLoader.class") == null
+                    && jar.getJarEntry(prefix + "QuestAndroidXRBridge.class") == null
+                    && jar.getJarEntry("org/vmstudio/visor/android/QuestVLoader.class") == null
+                    && jar.getJarEntry("org/vmstudio/visor/android/QuestAndroidXRBridge.class") == null) {
+                String holder = new String(entry(jar, "me/phoenixra/atumvr/core/session/platform/XRPlatform$Holder.class"), StandardCharsets.ISO_8859_1);
+                if (holder.contains("discoverAndroidBridge") && holder.contains("java/util/ServiceLoader")) return true;
+            }
+            throw new IOException("Unsupported Android Visor architecture; use Android 0.5 SPI or Forge 0.6 monolithic JAR");
+        } catch (RuntimeException e) { throw new IOException("Invalid custom Visor mod metadata", e); }
+    }
+}
diff --git a/src/main/java/pojlib/install/FabricLoaderProfile.java b/src/main/java/pojlib/install/FabricLoaderProfile.java
new file mode 100644
index 0000000000000000000000000000000000000000..2041ec6a2106fb523408349b4f65fc490b5f666f
--- /dev/null
+++ b/src/main/java/pojlib/install/FabricLoaderProfile.java
@@ -0,0 +1,204 @@
+package pojlib.install;
+
+import com.google.gson.Gson;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.security.*;
+import java.util.*;
+import java.util.regex.*;
+import pojlib.util.json.MinecraftInstances;
+
+/** Explicit Fabric versions, verified official profiles and transactional classpath migration. */
+public final class FabricLoaderProfile {
+    public static final String DEFAULT_VERSION = "0.17.2";
+    public static final String LEGACY_VERSION = "0.16.14";
+    private FabricLoaderProfile() { }
+    public static void validateVersion(String version) {
+        if (version == null || !version.matches("(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)"))
+            throw new IllegalArgumentException("Fabric Loader version must be numeric, for example 0.17.2");
+    }
+    public static String inferVersion(String classpath) {
+        if (classpath != null) {
+            Matcher matcher = Pattern.compile("(?:^|/)net/fabricmc/fabric-loader/([0-9]+\\.[0-9]+\\.[0-9]+)/").matcher(classpath.replace('\\', '/'));
+            if (matcher.find()) return matcher.group(1);
+        }
+        return LEGACY_VERSION;
+    }
+    public static VersionInfo fetch(String minecraft, String loader) throws IOException {
+        validateVersion(loader);
+        if (!"1.20.1".equals(minecraft)) throw new IOException("Fabric Loader selection requires Minecraft 1.20.1");
+        String url = "https://meta.fabricmc.net/v2/versions/loader/" + minecraft + "/" + loader + "/profile/json";
+        byte[] json = readHttps(url, 2097152);
+        try {
+            VersionInfo profile = new Gson().fromJson(new String(json, StandardCharsets.UTF_8), VersionInfo.class);
+            validateProfile(profile, minecraft, loader);
+            return profile;
+        } catch (RuntimeException error) { throw new IOException("Invalid official Fabric Loader profile", error); }
+    }
+    public static void validateProfile(VersionInfo profile, String minecraft, String loader) throws IOException {
+        validateVersion(loader);
+        if (!"1.20.1".equals(minecraft) || profile == null || ! ("fabric-loader-" + loader + "-" + minecraft).equals(profile.id)
+                || !"net.fabricmc.loader.impl.launch.knot.KnotClient".equals(profile.mainClass)
+                || profile.libraries == null || profile.libraries.length == 0)
+            throw new IOException("Official Fabric profile does not match the selected Minecraft/Loader version");
+        boolean hasLoader = false, hasIntermediary = false;
+        for (VersionInfo.Library library : profile.libraries) {
+            String path = libraryPath(library.name);
+            if (!"https://maven.fabricmc.net/".equals(library.url)) throw new IOException("Unexpected Fabric library repository");
+            if (library.name.equals("net.fabricmc:fabric-loader:" + loader)) hasLoader = true;
+            if (library.name.equals("net.fabricmc:intermediary:" + minecraft)) hasIntermediary = true;
+        }
+        if (!hasLoader || !hasIntermediary) throw new IOException("Fabric profile is missing Loader or Intermediary");
+        jvmArguments(profile);
+    }
+    public static String[] libraryNames(VersionInfo profile) {
+        return Arrays.stream(profile.libraries).map(library -> library.name).toArray(String[]::new);
+    }
+    public static String[] jvmArguments(VersionInfo profile) throws IOException {
+        if (profile.arguments == null || profile.arguments.jvm == null) return new String[0];
+        List<String> arguments = new ArrayList<>();
+        for (Object argument : profile.arguments.jvm) {
+            if (!(argument instanceof String)) throw new IOException("Unsupported Fabric JVM argument rule");
+            String value = (String) argument;
+            if (!value.startsWith("-D")) throw new IOException("Unexpected Fabric JVM argument");
+            arguments.add(value);
+        }
+        return arguments.toArray(new String[0]);
+    }
+    public static String libraryPath(String coordinate) {
+        String[] parts = coordinate == null ? new String[0] : coordinate.split(":", -1);
+        if (parts.length != 3 || !parts[0].matches("[a-zA-Z0-9_.-]+") || !parts[1].matches("[a-zA-Z0-9_.-]+")
+                || !parts[2].matches("[a-zA-Z0-9_.+\\-]+")) throw new IllegalArgumentException("Invalid Fabric Maven coordinate: " + coordinate);
+        return parts[0].replace('.', '/') + "/" + parts[1] + "/" + parts[2] + "/" + parts[1] + "-" + parts[2] + ".jar";
+    }
+    private static String identity(String coordinate) {
+        libraryPath(coordinate);
+        return coordinate.substring(0, coordinate.lastIndexOf(':'));
+    }
+    static String identityFromPath(String path) {
+        String normal = path.replace('\\', '/');
+        int libraries = normal.indexOf("/libraries/");
+        if (libraries < 0) return null;
+        String[] parts = normal.substring(libraries + 11).split("/");
+        if (parts.length < 4) return null;
+        String artifact = parts[parts.length - 3], version = parts[parts.length - 2];
+        if (!parts[parts.length - 1].equals(artifact + "-" + version + ".jar")) return null;
+        String group = String.join(".", Arrays.copyOf(parts, parts.length - 3));
+        return group + ":" + artifact;
+    }
+    public static String migrateClasspath(String oldClasspath, String[] oldCoordinates, String[] newCoordinates, String newLibraries) {
+        if (oldClasspath == null || oldClasspath.isEmpty()) throw new IllegalArgumentException("Fabric classpath is missing");
+        Set<String> replaced = new HashSet<>();
+        for (String coordinate : oldCoordinates) replaced.add(identity(coordinate));
+        for (String coordinate : newCoordinates) replaced.add(identity(coordinate));
+        List<String> result = new ArrayList<>();
+        String[] replacements = newLibraries.split(Pattern.quote(File.pathSeparator));
+        boolean inserted = false;
+        for (String entry : oldClasspath.split(Pattern.quote(File.pathSeparator))) {
+            if (entry.isEmpty()) continue;
+            if (replaced.contains(identityFromPath(entry))) {
+                if (!inserted) { result.addAll(Arrays.asList(replacements)); inserted = true; }
+            } else result.add(entry);
+        }
+        if (!inserted) throw new IllegalArgumentException("Cannot locate existing Fabric libraries in classpath");
+        return String.join(File.pathSeparator, new LinkedHashSet<>(result));
+    }
+    public static String installLibraries(VersionInfo profile, File libraryHome) throws IOException {
+        List<String> installed = new ArrayList<>();
+        for (VersionInfo.Library library : profile.libraries) {
+            String path = libraryPath(library.name);
+            String sha1 = library.sha1;
+            if (sha1 == null) sha1 = new String(readHttps(library.url + path + ".sha1", 512), StandardCharsets.UTF_8).trim();
+            if (!sha1.matches("(?i)[a-f0-9]{40}")) throw new IOException("Invalid Fabric library SHA-1: " + library.name);
+            File target = new File(libraryHome, "libraries/" + path);
+            if (!target.isFile() || !sha1.equalsIgnoreCase(hash(target))) {
+                Files.createDirectories(target.getParentFile().toPath());
+                File staged = File.createTempFile(target.getName(), ".installing", target.getParentFile());
+                try {
+                    downloadHttps(library.url + path, staged);
+                    if (!sha1.equalsIgnoreCase(hash(staged))) throw new IOException("Fabric library verification failed: " + library.name);
+                    Files.move(staged.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
+                } finally { Files.deleteIfExists(staged.toPath()); }
+            }
+            installed.add(target.getAbsolutePath());
+        }
+        return String.join(File.pathSeparator, installed);
+    }
+    public static void applyRequested(MinecraftInstances.Instance instance, MinecraftInstances instances, File libraryHome, File registry) throws IOException {
+        if (!"Fabric".equals(instance.getModLoader())) return;
+        String requested = instance.getSelectedFabricLoaderVersion();
+        String installed = instance.getInstalledFabricLoaderVersion();
+        validateVersion(requested);
+        if (requested.equals(installed)) return;
+        VersionInfo profile = fetch(instance.versionName, requested);
+        String[] oldCoordinates = instance.fabricLoaderLibraries;
+        if (oldCoordinates == null || oldCoordinates.length == 0) oldCoordinates = libraryNames(fetch(instance.versionName, installed));
+        String libraries = installLibraries(profile, libraryHome);
+        final String migrated;
+        try { migrated = migrateClasspath(instance.classpath, oldCoordinates, libraryNames(profile), libraries); }
+        catch (IllegalArgumentException error) { throw new IOException("Fabric profile migration failed", error); }
+        commitPrepared(instance, instances, profile, requested, installed, migrated, registry);
+    }
+    static void commitPrepared(MinecraftInstances.Instance instance, MinecraftInstances instances, VersionInfo profile, String requested, String installed, String migrated, File registry) throws IOException {
+        String[] arguments = jvmArguments(profile);
+        // Downloads and computation finish first; registry writes must also succeed.
+        synchronized (instances) {
+            if (!requested.equals(instance.getSelectedFabricLoaderVersion()) || !installed.equals(instance.getInstalledFabricLoaderVersion()))
+                throw new IOException("Fabric Loader selection changed during installation; retry launch");
+            if (registry.isFile()) Files.copy(registry.toPath(), new File(registry.getParentFile(), "instances-before-fabric-" + UUID.randomUUID() + ".json").toPath());
+            String oldClasspath = instance.classpath, oldMain = instance.mainClass, oldInstalled = instance.fabricInstalledLoaderVersion;
+            String[] oldLibraries = instance.fabricLoaderLibraries, oldArguments = instance.fabricJvmArguments;
+            instance.classpath = migrated;
+            instance.mainClass = profile.mainClass;
+            instance.fabricLoaderLibraries = libraryNames(profile);
+            instance.fabricJvmArguments = arguments;
+            instance.fabricInstalledLoaderVersion = requested;
+            try { saveRegistry(instances, registry); }
+            catch (IOException error) {
+                instance.classpath = oldClasspath; instance.mainClass = oldMain;
+                instance.fabricInstalledLoaderVersion = oldInstalled;
+                instance.fabricLoaderLibraries = oldLibraries; instance.fabricJvmArguments = oldArguments;
+                throw error;
+            }
+        }
+    }
+    public static void saveRegistry(MinecraftInstances instances, File registry) throws IOException {
+        Files.createDirectories(registry.getAbsoluteFile().getParentFile().toPath());
+        File temporary = File.createTempFile("instances-", ".json.installing", registry.getAbsoluteFile().getParentFile());
+        try {
+            Files.write(temporary.toPath(), new Gson().toJson(instances).getBytes(StandardCharsets.UTF_8));
+            try { Files.move(temporary.toPath(), registry.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING); }
+            catch (AtomicMoveNotSupportedException error) { Files.move(temporary.toPath(), registry.toPath(), StandardCopyOption.REPLACE_EXISTING); }
+        } finally { Files.deleteIfExists(temporary.toPath()); }
+    }
+    private static String hash(File file) throws IOException {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-1");
+            try (InputStream input = new FileInputStream(file)) { byte[] bytes = new byte[16384]; int count; while ((count = input.read(bytes)) != -1) digest.update(bytes, 0, count); }
+            StringBuilder text = new StringBuilder(); for (byte value : digest.digest()) text.append(String.format(Locale.ROOT, "%02x", value & 255)); return text.toString();
+        } catch (NoSuchAlgorithmException error) { throw new IOException(error); }
+    }
+    private static byte[] readHttps(String url, int limit) throws IOException {
+        ByteArrayOutputStream output = new ByteArrayOutputStream(); transferHttps(url, output, limit); return output.toByteArray();
+    }
+    private static void downloadHttps(String url, File file) throws IOException {
+        try (OutputStream output = new FileOutputStream(file)) { transferHttps(url, output, 67108864); }
+    }
+    private static void transferHttps(String url, OutputStream output, int limit) throws IOException {
+        URL location = new URL(url);
+        if (!"https".equals(location.getProtocol())) throw new IOException("Fabric downloads require HTTPS");
+        HttpURLConnection connection = (HttpURLConnection) location.openConnection();
+        connection.setConnectTimeout(15000); connection.setReadTimeout(15000); connection.setInstanceFollowRedirects(false);
+        long deadline = System.nanoTime() + 120000000000L;
+        try {
+            int status = connection.getResponseCode();
+            if (status != 200) throw new IOException("Fabric download returned HTTP " + status + "; selected profile retained");
+            if (connection.getContentLengthLong() > limit) throw new IOException("Fabric download exceeds size limit");
+            try (InputStream input = connection.getInputStream()) { byte[] bytes = new byte[16384]; int total = 0, count;
+                while ((count = input.read(bytes)) != -1) { total += count; if (total > limit || System.nanoTime() > deadline) throw new IOException("Fabric download exceeded size/time limit"); output.write(bytes, 0, count); }
+            }
+        } finally { connection.disconnect(); }
+    }
+}
