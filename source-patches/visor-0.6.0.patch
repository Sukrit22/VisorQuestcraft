+import com.github.jengelman.gradle.plugins.shadow.tasks.ShadowJar
+
+// Build script of every ":visor-forge:<mc>" subproject.
+plugins {
+    id "visor.loader"
+}
+
+// Atum Configuration for Dev Runtime on Forge
+configurations {
+    atumConfigRaw { canBeConsumed = false; canBeResolved = true; transitive = false }
+}
+dependencies {
+    atumConfigRaw "com.github.Phoenix-Ra.AtumConfiguration:atumconfig-core:${atumconfig_version}"
+}
+def devAtumConfigJar = tasks.register("devAtumConfigJar", ShadowJar) {
+    description = "Relocated AtumConfiguration for the Forge dev runtime"
+    configurations = [project.configurations.atumConfigRaw]
+    archiveBaseName = "atumconfig-dev"
+    archiveVersion = ""
+    archiveClassifier = ""
+    destinationDirectory = layout.buildDirectory.dir("dev-runtime")
+    ["com.google.gson": "gson", "org.yaml.snakeyaml": "snakeyaml", "com.google.errorprone": "errorprone"].each { pkg, alias ->
+        relocate pkg, "me.phoenixra.atumconfig.libs.${alias}"
+    }
+    exclude "META-INF/versions/**", "module-info.class"
+}
+// LWJGL for the Forge dev runtime
+configurations {
+    lwjglRaw { canBeConsumed = false; canBeResolved = true; transitive = false }
+}
+dependencies {
+    lwjglRaw files(rootProject.file('libs/lwjgl-openxr-quest-3.3.3.jar'))
+    lwjglRaw "org.lwjgl:lwjgl-vulkan:${lwjgl_version}"
+}
+def devNativesJar = tasks.register("devNativesJar", Jar) {
+    description = "LWJGL OpenXR and Vulkan without module-info, for the Forge dev runtime"
+    archiveBaseName = "lwjgl-visor-dev"
+    archiveVersion = ""
+    archiveClassifier = ""
+    destinationDirectory = layout.buildDirectory.dir("dev-runtime")
+    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
+    from { configurations.lwjglRaw.collect { zipTree(it) } }
+    // LWJGL keeps its only module descriptor under META-INF/versions/11, so the whole
+    // directory goes - and with it the Multi-Release manifests, or securejarhandler would
+    // look for a path that is no longer there.
+    exclude "META-INF/versions/**", "META-INF/MANIFEST.MF",
+            "META-INF/*.SF", "META-INF/*.DSA", "META-INF/*.RSA"
+}
+//------
+
+//excluding unnecessary stuff for Dev runtime
+configurations.runtimeClasspath {
+    exclude group: "com.github.Phoenix-Ra", module: "AtumConfiguration"
+    exclude group: "com.github.Phoenix-Ra.AtumConfiguration"
+
+    exclude group: "com.github.Phoenix-Ra.AtumVR"
+    exclude module: "atumvr-api-${atumvr_version}"
+    exclude module: "atumvr-core-${atumvr_version}"
+}
+
+dependencies {
+    forge "net.minecraftforge:forge:${minecraft_version}-${forge_version}"
+
+    // We need it for @Environment annotation, to mark methods/classes
+    // Forge ignores this annotation, but addons will see
+    compileOnly("net.fabricmc:fabric-loader:${fabric_loader_version}") { transitive = false }
+
+    // Forge 1.20.1 use Mixin 0.8.5, which has no @Inject(order = ..) The shared sources use it,
+    // so compile against the 0.8.7 annotations; Forge's runtime simply ignores the extra attribute.
+    compileOnly("dev.architectury:mixin-patched:0.8.7.12") { transitive = false }
+
+    compileOnly(annotationProcessor("io.github.llamalad7:mixinextras-common:${mixin_extras_version}"))
+    implementation(include("io.github.llamalad7:mixinextras-forge:${mixin_extras_version}"))
+
+    //Natives
+    forgeRuntimeLibrary files(devNativesJar)
+
+    shadowBundle files(rootProject.file('libs/lwjgl-openxr-quest-3.3.3.jar'))
+    shadowBundle("org.lwjgl:lwjgl-vulkan:${lwjgl_version}") { transitive = false }
+
+    // Dev Runtime
+    forgeRuntimeLibrary(atumvr("api")) { transitive = false }
+    forgeRuntimeLibrary(atumvr("core")) { transitive = false }
+    forgeRuntimeLibrary files(devAtumConfigJar)
+}
+
+loom {
+    forge {
+        convertAccessWideners = true
+        extraAccessWideners.add loom.accessWidenerPath.get().asFile.name
+
+        mixinConfig "${mod_id}.mixins.json"
+        mixinConfig "${mod_id}.sodium.mixins.json"
+        mixinConfig "${mod_id}.replaymod.mixins.json"
+        mixinConfig "${mod_id}.flashback.mixins.json"
+        mixinConfig "${mod_id}.dh.mixins.json"
+        mixinConfig "${mod_id}.dynamicfps.mixins.json"
+        mixinConfig "${mod_id}.iris.mixins.json"
+        mixinConfig "${mod_id}.blur.mixins.json"
+        mixinConfig "${mod_id}.create.mixins.json"
+        mixinConfig "${mod_id}.mixins.forge.json"
+    }
+}
