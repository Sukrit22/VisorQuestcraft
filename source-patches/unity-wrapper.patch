@@ -0,0 +1,35 @@
+using System;
+using System.IO;
+using System.Reflection;
+using UnityEngine;
+
+public static class VerifyDiagnostics
+{
+    public static void Run()
+    {
+        int checks = 0;
+        foreach (string secret in new[] {
+            "Authorization: Bearer TEST_SECRET", "access_token=TEST_SECRET", "refreshToken: TEST_SECRET",
+            "--accessToken TEST_SECRET", "enter the code TEST_SECRET to authenticate.",
+            "Added custom env: ANY_KEY=TEST_SECRET", "https://example.test/?code=TEST_SECRET",
+            "password: TEST_SECRET", "user_code=TEST_SECRET", "session id: TEST_SECRET"
+        }) {
+            string cleaned = LogUploader.Redact("Useful error before\n" + secret + "\nUseful error after");
+            if (cleaned.Contains("TEST_SECRET") || !cleaned.Contains("Useful error before") || !cleaned.Contains("Useful error after"))
+                throw new Exception("Credential redaction regression");
+            checks++;
+        }
+        string temp = Path.GetFullPath("Library/diagnostics-test-fixture.txt");
+        File.WriteAllText(temp, "Authorization: Bearer TEST_SECRET\nvisible error\n");
+        var read = typeof(LogUploader).GetMethod("ReadTail", BindingFlags.Static | BindingFlags.NonPublic);
+        string tail = (string)read.Invoke(null, new object[] { temp, 28L });
+        if (tail.Contains("SECRET") || !tail.Contains("visible error")) throw new Exception("Partial credential line retained");
+        checks++;
+        string report = LogUploader.BuildReport(null, "test");
+        if (!report.Contains("JNI initialized:") || !report.Contains("App:") || !report.Contains("=== Launcher Unity log"))
+            throw new Exception("Uninitialized launcher cannot export metadata");
+        checks++;
+        Debug.Log("PASS diagnostics checks: " + checks);
+        VerifyLauncherLogin.Run();
+    }
+}
