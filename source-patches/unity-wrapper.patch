diff --git a/Assets/Editor/VerifyLauncherLogin.cs b/Assets/Editor/VerifyLauncherLogin.cs
new file mode 100644
index 0000000000000000000000000000000000000000..274cc5a9a8b851195864228e8da6a970da3eb15f
--- /dev/null
+++ b/Assets/Editor/VerifyLauncherLogin.cs
@@ -0,0 +1,64 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using TMPro;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.UI;
+
+public static class VerifyLauncherLogin
+{
+    private static int checks;
+    private static void Check(bool condition, string message)
+    {
+        if (!condition) throw new Exception("Login regression: " + message);
+        checks++;
+    }
+    public static void Run()
+    {
+        EditorSceneManager.OpenScene("Assets/Scenes/Main.unity");
+        var ui = UnityEngine.Object.FindFirstObjectByType<UIHandler>();
+        var login = ui.loginHandler;
+        Check(login != null && login.loginText != null, "scene login references");
+        ui.killButton.gameObject.SetActive(false);
+        ui.dropdownMain.ClearOptions();
+        ui.dropdownMain.AddOptions(new List<string> { "test" });
+        var loggedIn = typeof(LoginHandler).GetProperty("IsLoggedIn");
+        var busy = typeof(LoginHandler).GetProperty("IsBusy");
+        foreach (bool demo in new[] {false, true}) {
+            login.isDemoMode = demo;
+            loggedIn.SetValue(login, true);
+            busy.SetValue(login, false);
+            ui.UILoginCheck();
+            Check(ui.instancesButton.interactable && ui.modsButton.interactable && ui.dropdownMain.interactable, "instance access with demo=" + demo);
+            Check(ui.playButton.interactable, "authenticated/demo launch remains available");
+        }
+        loggedIn.SetValue(login, false);
+        ui.UILoginCheck();
+        Check(ui.instancesButton.interactable && !ui.playButton.interactable, "signed-out can manage but cannot launch");
+        loggedIn.SetValue(login, true);
+        busy.SetValue(login, true);
+        ui.UILoginCheck();
+        Check(!ui.playButton.interactable && !ui.logoutButton.interactable, "pending login cannot launch/logout");
+        busy.SetValue(login, false);
+        ui.killButton.gameObject.SetActive(true);
+        ui.UILoginCheck();
+        Check(!ui.instancesButton.interactable && !ui.playButton.interactable, "running game locks management");
+        ui.killButton.gameObject.SetActive(false);
+        typeof(LoginHandler).GetMethod("PrepareStatusPanel", BindingFlags.NonPublic | BindingFlags.Instance).Invoke(login, null);
+        var label = login.loginText.GetComponentInChildren<TextMeshProUGUI>();
+        Check(!label.raycastTarget && !label.richText, "status does not intercept input or parse auth text as markup");
+        Check(login.loginText.GetComponentsInChildren<Button>().Length == 2, "sign-in and copy actions exist");
+        string temporary = Path.GetTempFileName();
+        try {
+            File.WriteAllText(temporary, "{\"accounts\":null,\"lastSelectedAccount\":99}");
+            typeof(LoginHandler).GetField("configPath", BindingFlags.NonPublic | BindingFlags.Instance).SetValue(login, temporary);
+            login.ParseAccounts();
+            Check(login.accounts.Count == 1 && login.accounts[0].username == "Add Account", "fresh/null account list is safe");
+            Check(!login.IsBusy, "parsing does not launch authentication");
+        } finally { File.Delete(temporary); }
+        Debug.Log("PASS launcher login regression checks: " + checks);
+        // Deliberately do not save the temporary scene mutations.
+    }
+}
