diff --git a/Assets/Editor/QuestCraftManifestPolicy.cs b/Assets/Editor/QuestCraftManifestPolicy.cs
new file mode 100644
index 0000000000000000000000000000000000000000..968d1597809aacee9ff03ff67e0b07d11691238f
--- /dev/null
+++ b/Assets/Editor/QuestCraftManifestPolicy.cs
@@ -0,0 +1,44 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Xml;
+using UnityEditor.Android;
+
+// Runs after SDK hooks, including Pico PlatformManifestRewrite (order 9999).
+// This modifies generated files only, never third-party SDK source.
+public sealed class QuestCraftManifestPolicy : IPostGenerateGradleAndroidProject
+{
+    public int callbackOrder => int.MaxValue;
+    private const string AndroidNamespace = "http://schemas.android.com/apk/res/android";
+    public void OnPostGenerateGradleAndroidProject(string path)
+    {
+        var target = QuestCraftAndroidBuild.ActiveTarget;
+        if (target == null) return;
+        var manifest = Path.Combine(path, "src/main/AndroidManifest.xml");
+        if (!File.Exists(manifest)) throw new InvalidOperationException("Generated manifest missing: " + manifest);
+        var xml = new XmlDocument(); xml.Load(manifest);
+        foreach (XmlElement node in xml.SelectNodes("//*").Cast<XmlNode>().OfType<XmlElement>().ToArray())
+        {
+            string name = node.GetAttribute("name", AndroidNamespace);
+            if ((target == "Quest" && (name.StartsWith("pvr.") || name.StartsWith("com.picovr.") || name == "use_record_highlight_feature"))
+                || (target == "Pico" && (name.StartsWith("com.oculus.") || name.StartsWith("oculus."))))
+                node.ParentNode.RemoveChild(node);
+        }
+        if (target == "Quest")
+        {
+            var app = xml.SelectSingleNode("/manifest/application");
+            SetMetadata(xml, app, "com.oculus.supportedDevices", "eureka");
+            foreach (XmlElement activity in app.SelectNodes("activity"))
+                if (activity.GetAttribute("name", AndroidNamespace) == "pojlib.UnityPlayerActivity")
+                    SetMetadata(xml, activity, "com.oculus.vr.focusaware", "true");
+        }
+        xml.Save(manifest);
+    }
+    private static void SetMetadata(XmlDocument xml, XmlNode parent, string name, string value)
+    {
+        var node = parent.SelectNodes("meta-data").Cast<XmlElement>().FirstOrDefault(n => n.GetAttribute("name", AndroidNamespace) == name);
+        if (node == null) { node = xml.CreateElement("meta-data"); parent.AppendChild(node); }
+        node.SetAttribute("name", AndroidNamespace, name);
+        node.SetAttribute("value", AndroidNamespace, value);
+    }
+}
