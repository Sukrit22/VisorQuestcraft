diff --git a/Assets/Editor/QuestCraftAndroidBuild.cs b/Assets/Editor/QuestCraftAndroidBuild.cs
new file mode 100644
index 0000000000000000000000000000000000000000..697bdd28b42663ea8836b8fe161b2cca85bd0021
--- /dev/null
+++ b/Assets/Editor/QuestCraftAndroidBuild.cs
@@ -0,0 +1,138 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Xml;
+using UnityEditor;
+using UnityEditor.Build.Reporting;
+using UnityEngine;
+using UnityEngine.Rendering;
+using UnityEngine.XR.OpenXR;
+using UnityEngine.XR.OpenXR.Features;
+
+
+
+
+public static class QuestCraftAndroidBuild
+{
+    [Serializable] public class Target { public string name, applicationId, productName, method; }
+    [Serializable] public class Configuration { public string release, minecraft, forge, visorAsset, visorBuild; public int versionCode; public Target[] targets; }
+    [Serializable] public class Evidence { public string target, applicationId, release, forge, visorAsset; public string[] enabledFeatures, excludedPlugins; }
+    internal static string ActiveTarget;
+    private const string AndroidNamespace = "http://schemas.android.com/apk/res/android";
+
+    [MenuItem("QuestCraft/Build/Pico APK")]
+    public static void BuildPico() => Build("Pico");
+    [MenuItem("QuestCraft/Build/Quest APK")]
+    public static void BuildQuest() => Build("Quest");
+
+    private static bool IsPico(string value) => value.IndexOf("pico", StringComparison.OrdinalIgnoreCase) >= 0;
+    private static bool IsVendorOrInput(OpenXRFeature feature)
+    {
+        var type = feature.GetType();
+        return IsPico(type.FullName) || type.Name.Contains("Meta") || type.Name.Contains("Oculus")
+            || type.Name.Contains("HandTracking") || type.Name.Contains("ControllerProfile")
+            || type.Name.Contains("MockRuntime");
+    }
+
+    private static void Build(string targetName)
+    {
+        string workspace = Path.GetFullPath(Path.Combine(Application.dataPath, "../../.."));
+        var config = JsonUtility.FromJson<Configuration>(File.ReadAllText(Path.Combine(workspace, "build-targets/android.json")));
+        var target = config.targets.Single(t => t.name == targetName);
+        bool pico = targetName == "Pico";
+        if (!EditorUserBuildSettings.SwitchActiveBuildTarget(BuildTargetGroup.Android, BuildTarget.Android))
+            throw new InvalidOperationException("Cannot select Android build target.");
+        UnityEditor.XR.OpenXR.Features.FeatureHelpers.RefreshFeatures(BuildTargetGroup.Android);
+        var settings = OpenXRSettings.GetSettingsForBuildTargetGroup(BuildTargetGroup.Android);
+        if (settings == null) throw new InvalidOperationException("Android OpenXR settings missing");
+        var features = settings.GetFeatures<OpenXRFeature>();
+        var states = features.ToDictionary(f => f, f => f.enabled);
+        OpenXRFeature[] required = pico ? PicoBuildProfile.RequiredFeatures(settings) : QuestBuildProfile.RequiredFeatures(settings);
+        if (required.Any(f => f == null)) throw new InvalidOperationException(targetName + " XR features unavailable");
+        var picoPlugins = PluginImporter.GetAllImporters().Where(p => IsPico(p.assetPath)).ToArray();
+        var excludedPlugins = picoPlugins.Where(p => !pico ||
+            Path.GetFileName(p.assetPath).StartsWith("gson-", StringComparison.OrdinalIgnoreCase)).ToArray();
+        var pluginStates = picoPlugins.ToDictionary(p => p, p => p.GetCompatibleWithPlatform(BuildTarget.Android));
+        var pluginAny = picoPlugins.ToDictionary(p => p, p => p.GetCompatibleWithAnyPlatform());
+        string manifest = Path.Combine(Application.dataPath, "Plugins/Android/AndroidManifest.xml");
+        byte[] originalManifest = File.ReadAllBytes(manifest);
+        string identifier = PlayerSettings.GetApplicationIdentifier(BuildTargetGroup.Android);
+        string product = PlayerSettings.productName, version = PlayerSettings.bundleVersion;
+        int versionCode = PlayerSettings.Android.bundleVersionCode;
+        bool key = PlayerSettings.Android.useCustomKeystore, graphicsAuto = PlayerSettings.GetUseDefaultGraphicsAPIs(BuildTarget.Android);
+        var graphics = PlayerSettings.GetGraphicsAPIs(BuildTarget.Android);
+        var architecture = PlayerSettings.Android.targetArchitectures;
+        var scripting = PlayerSettings.GetScriptingBackend(UnityEditor.Build.NamedBuildTarget.Android);
+        string output = Path.Combine(workspace, "outputs", "QuestCraft-Forge-" + config.minecraft + "-Visor-0.5.0-" + targetName + "-" + config.release + ".apk");
+        try
+        {
+            foreach (var feature in features.Where(IsVendorOrInput)) { feature.enabled = required.Contains(feature); EditorUtility.SetDirty(feature); }
+            foreach (var feature in required) { feature.enabled = true; EditorUtility.SetDirty(feature); }
+            // The Pico SDK contains a custom loader and optional platform/enterprise plugins.
+            // Quest excludes vendor plugins; both targets use the explicitly declared
+            // Gradle Gson dependency instead of the Pico SDK's duplicate Gson JAR.
+            foreach (var plugin in excludedPlugins)
+            {
+                plugin.SetCompatibleWithAnyPlatform(false);
+                plugin.SetCompatibleWithPlatform(BuildTarget.Android, false);
+                plugin.SaveAndReimport();
+            }
+            var xml = new XmlDocument(); xml.Load(manifest);
+            foreach (XmlElement node in xml.SelectNodes("//*").Cast<XmlNode>().OfType<XmlElement>().ToArray())
+            {
+                string name = node.GetAttribute("name", AndroidNamespace);
+                if ((!pico && (name.StartsWith("pvr.") || name.StartsWith("com.picovr.")))
+                    || (pico && (name.StartsWith("com.oculus.") || name.StartsWith("oculus."))))
+                    node.ParentNode.RemoveChild(node);
+            }
+            xml.Save(manifest);
+            AssetDatabase.ImportAsset("Assets/Plugins/Android/AndroidManifest.xml");
+            PlayerSettings.SetApplicationIdentifier(BuildTargetGroup.Android, target.applicationId);
+            PlayerSettings.productName = target.productName;
+            PlayerSettings.bundleVersion = "0.5.0-" + targetName.ToLowerInvariant() + "-" + config.release;
+            PlayerSettings.Android.bundleVersionCode = config.versionCode;
+            PlayerSettings.Android.useCustomKeystore = false;
+            PlayerSettings.Android.targetArchitectures = AndroidArchitecture.ARM64;
+            PlayerSettings.SetScriptingBackend(UnityEditor.Build.NamedBuildTarget.Android, ScriptingImplementation.IL2CPP);
+            PlayerSettings.SetUseDefaultGraphicsAPIs(BuildTarget.Android, false);
+            PlayerSettings.SetGraphicsAPIs(BuildTarget.Android, new[] { GraphicsDeviceType.OpenGLES3 });
+            AssetDatabase.SaveAssets();
+            Directory.CreateDirectory(Path.GetDirectoryName(output));
+            var scenes = EditorBuildSettings.scenes.Where(s => s.enabled).Select(s => s.path).ToArray();
+            if (scenes.Length == 0) throw new InvalidOperationException("No launcher scenes enabled");
+            var evidence = new Evidence { target = targetName, applicationId = target.applicationId, release = config.release,
+                forge = config.forge, visorAsset = config.visorAsset,
+                enabledFeatures = features.Where(f => f.enabled).Select(f => f.GetType().FullName).ToArray(),
+                excludedPlugins = excludedPlugins.Select(p => p.assetPath).ToArray() };
+            Debug.Log("QUESTCRAFT_BUILD_PROFILE " + JsonUtility.ToJson(evidence));
+            ActiveTarget = targetName;
+            var report = BuildPipeline.BuildPlayer(new BuildPlayerOptions {
+                scenes = scenes, locationPathName = output, target = BuildTarget.Android, options = BuildOptions.None });
+            if (report.summary.result != BuildResult.Succeeded) throw new InvalidOperationException(targetName + " APK build failed: " + report.summary.totalErrors);
+            File.WriteAllText(output + ".build.json", JsonUtility.ToJson(evidence, true));
+        }
+        finally
+        {
+            ActiveTarget = null;
+            foreach (var pair in states) { pair.Key.enabled = pair.Value; EditorUtility.SetDirty(pair.Key); }
+            foreach (var plugin in picoPlugins)
+            {
+                plugin.SetCompatibleWithAnyPlatform(pluginAny[plugin]);
+                plugin.SetCompatibleWithPlatform(BuildTarget.Android, pluginStates[plugin]);
+                plugin.SaveAndReimport();
+            }
+            File.WriteAllBytes(manifest, originalManifest);
+            AssetDatabase.ImportAsset("Assets/Plugins/Android/AndroidManifest.xml");
+            PlayerSettings.SetApplicationIdentifier(BuildTargetGroup.Android, identifier);
+            PlayerSettings.productName = product; PlayerSettings.bundleVersion = version;
+            PlayerSettings.Android.bundleVersionCode = versionCode; PlayerSettings.Android.useCustomKeystore = key;
+            PlayerSettings.Android.targetArchitectures = architecture;
+            PlayerSettings.SetScriptingBackend(UnityEditor.Build.NamedBuildTarget.Android, scripting);
+            PlayerSettings.SetUseDefaultGraphicsAPIs(BuildTarget.Android, graphicsAuto);
+            PlayerSettings.SetGraphicsAPIs(BuildTarget.Android, graphics);
+            AssetDatabase.SaveAssets();
+        }
+    }
+}
+
+
