diff --git a/Assets/Editor/VerifyVisorRuntime.cs b/Assets/Editor/VerifyVisorRuntime.cs
new file mode 100644
index 0000000000000000000000000000000000000000..7a336223605c8caf83b186d3b7ed4b89f72c3d24
--- /dev/null
+++ b/Assets/Editor/VerifyVisorRuntime.cs
@@ -0,0 +1,92 @@
+using System;
+using System.Linq;
+using System.Reflection;
+using TMPro;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.UI;
+
+public static class VerifyVisorRuntime
+{
+    private static T Field<T>(InstanceManager manager, string name) =>
+        (T)typeof(InstanceManager).GetField(name, BindingFlags.NonPublic | BindingFlags.Instance).GetValue(manager);
+
+    public static void Run()
+    {
+        string preference = PlayerPrefs.GetString("questcraft.visorRuntime", "visor-0.5");
+        try
+        {
+            EditorSceneManager.OpenScene("Assets/Scenes/Main.unity");
+            InstanceManager manager = UnityEngine.Object.FindObjectOfType<InstanceManager>(true);
+            manager.Start();
+            TMP_Dropdown runtime = Field<TMP_Dropdown>(manager, "visorRuntimeDropdown");
+            TMP_InputField url = Field<TMP_InputField>(manager, "visorUrlInput");
+            TMP_InputField sha = Field<TMP_InputField>(manager, "visorShaInput");
+            TMP_InputField fabricVersion = Field<TMP_InputField>(manager, "fabricLoaderVersionInput");
+            Require(fabricVersion.text == "0.17.2", "New instances default to Fabric Loader 0.17.2");
+            Require(InstanceManager.IsValidFabricLoaderVersion("0.17.2") && InstanceManager.IsValidFabricLoaderVersion("1.2.3"), "Explicit future numeric versions must be accepted");
+            Require(!InstanceManager.IsValidFabricLoaderVersion("../0.17.2") && !InstanceManager.IsValidFabricLoaderVersion("0.17") && !InstanceManager.IsValidFabricLoaderVersion(""), "Malformed loader versions must be rejected");
+            Require(runtime.options.Count == 4, "All managed/manual/custom options must exist");
+            runtime.SetValueWithoutNotify(1);
+            manager.loaderDropdown.SetValueWithoutNotify(1);
+            manager.UpdateMenu();
+            Require(fabricVersion.gameObject.activeSelf, "Fabric version picker must be visible on Fabric");
+            Require(runtime.value == 0, "Fabric must reject experimental Visor 0.6");
+            manager.loaderDropdown.SetValueWithoutNotify(0);
+            runtime.SetValueWithoutNotify(1);
+            manager.UpdateMenu();
+            Require(!fabricVersion.gameObject.activeSelf, "Forge must hide Fabric version picker");
+            Require(runtime.value == 1, "Forge must allow experimental Visor 0.6");
+            manager.loaderDropdown.SetValueWithoutNotify(1);
+            runtime.SetValueWithoutNotify(3);
+            manager.UpdateMenu();
+            Require(url.gameObject.activeSelf && sha.gameObject.activeSelf, "Custom inputs must be visible");
+            RectTransform root = (RectTransform)manager.windowHandler.instanceCreator.transform;
+            RectTransform[] controls = new[] {
+                (RectTransform)manager.instanceName.transform, (RectTransform)manager.loaderDropdown.transform,
+                (RectTransform)manager.versionDropdown.transform, (RectTransform)runtime.transform,
+                (RectTransform)fabricVersion.transform,
+                (RectTransform)Field<TextMeshProUGUI>(manager, "fabricLoaderVersionLabel").transform,
+                (RectTransform)url.transform, (RectTransform)sha.transform,
+                (RectTransform)Field<Button>(manager, "pasteUrlButton").transform,
+                (RectTransform)Field<Button>(manager, "pasteShaButton").transform,
+                (RectTransform)Field<Button>(manager, "creatorButton").transform,
+                (RectTransform)Field<TextMeshProUGUI>(manager, "runtimeHint").transform,
+                (RectTransform)manager.windowHandler.instanceCreator.GetComponentsInChildren<Button>(true)
+                    .First(button => button.onClick.GetPersistentEventCount() > 0 &&
+                        button.onClick.GetPersistentMethodName(0) == "InstanceCreatorUnsetter").transform
+            };
+            Rect[] bounds = controls.Select(control => Bounds(root, control)).ToArray();
+            for (int i = 0; i < bounds.Length; i++)
+            {
+                Require(bounds[i].xMin >= -500f && bounds[i].xMax <= 500f && bounds[i].yMin >= -250f && bounds[i].yMax <= 250f,
+                    "Control outside launcher panel: " + controls[i].name + " " + bounds[i]);
+                for (int j = i + 1; j < bounds.Length; j++)
+                    Require(!bounds[i].Overlaps(bounds[j]), "Controls overlap: " + controls[i].name + " / " + controls[j].name);
+            }
+            runtime.SetValueWithoutNotify(2);
+            manager.UpdateMenu();
+            Require(!url.gameObject.activeSelf && !sha.gameObject.activeSelf, "Manual mode must hide managed URL controls");
+            Require(fabricVersion.gameObject.activeSelf, "Fabric version remains independent of manual Visor mode");
+            Debug.Log("PASS Visor runtime UI and Fabric Loader picker: four choices, Forge/Fabric policy, custom visibility, panel geometry and overlap checks");
+        }
+        finally
+        {
+            PlayerPrefs.SetString("questcraft.visorRuntime", preference);
+            PlayerPrefs.Save();
+        }
+    }
+
+    private static Rect Bounds(RectTransform root, RectTransform control)
+    {
+        Vector3[] corners = new Vector3[4];
+        control.GetWorldCorners(corners);
+        Vector3[] local = corners.Select(root.InverseTransformPoint).ToArray();
+        return Rect.MinMaxRect(local.Min(p => p.x), local.Min(p => p.y), local.Max(p => p.x), local.Max(p => p.y));
+    }
+
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new Exception(message);
+    }
+}
